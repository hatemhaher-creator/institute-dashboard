document.addEventListener('DOMContentLoaded', () => {
  fillHeader();
  setupTabs();
  buildOverview();
  buildQuestions();
  buildTeachers();
  buildBranches();
  buildCompare();
  buildTrend();
  buildHeatmap();
  buildComments();
  buildResponses();
  buildInsights();
});




