  document.getElementById('comments-count').textContent = `${allComments.length} comments`;
  const inl = document.getElementById('cm-count-inline');
  if (inl) inl.textContent = allComments.length;

  // Theme classification — keyword heuristics
  const themes = [
    { name: 'Praise for teacher', keywords: ['ممتاز','رائع','الأفضل','أحسن','احسن','الله','مهتم','صبور','جيدة','جيد','professional','best','great','excellent','amazing','good','جزاها','مس ايمان','perfect','wonderful','the best','المعلمة ممتازة'], cls: 'good', items: [] },
    { name: 'Schedule / time complaints', keywords: ['وقت','الوقت','الساعة','الساعه','غير الوقت','تغير','من 4','من ٤','من 3','من ٣','الى 5','الى ٥','الى 6','الى ٦','schedule','timing','time','تعديل الوقت','الدوام'], cls: 'warn', items: [] },
    { name: 'Curriculum & book difficulty', keywords: ['الكتاب','المنهج','المنهاج','مصعب','صعب','مستوى','المستوى','curriculum','book','difficult','hard','easy','level'], cls: 'warn', items: [] },
    { name: 'Wants more activities/games', keywords: ['نشاط','أنشطه','انشطه','أنشطة','فعاليات','فعالية','ألعاب','العاب','games','activities','fun','ممل','مل'], cls: 'gold', items: [] },
    { name: 'Wants more Arabic explanation', keywords: ['عربية','عربي','الترجمة','نستوعب','اكثر عربي','بالعربي','arabic','translate'], cls: 'gold', items: [] },
    { name: 'Facility / environment issues', keywords: ['تكييف','تكيف','حر','حار','الكونتنر','كونتينر','مكيف','مكان','room','heat','cold','الفصل ضيق','ضيق','aircondition','ac'], cls: 'bad', items: [] },
    { name: 'Surprise tests complaint', keywords: ['اختبارات مفاجئة','اختبار مفاجئ','مفاجئة','surprise test','بدون إخبار','بدون اخبار','بدون اخبارنا','please inform','inform us'], cls: 'warn', items: [] },
    { name: 'Wants higher-level courses', keywords: ['مستوى أعلى','أعلى','ليفلات عاليه','مستويات أعلى','advanced','higher level'], cls: 'gold', items: [] },
    { name: 'Fees / value for money', keywords: ['غالي','الرسوم','رسوم','سعر','أسعار','اسعار','تخفيض','تقليل من الرسوم','بفلوس','expensive','price','cost'], cls: 'bad', items: [] },
    { name: 'Registration / institute info', keywords: ['تسجيل','الدورات','الدورة القادمة','register','الإدارة','الادارة','المعهد'], cls: 'gold', items: [] },
    { name: 'Other suggestions', keywords: [], cls: '', items: [] },
  ];

  allComments.forEach(c => {
    const t = c.text.toLowerCase();
    let matched = false;
    for (const theme of themes.slice(0, -1)) {
      if (theme.keywords.some(k => t.includes(k.toLowerCase()))) {
        theme.items.push(c);
        matched = true;
        break;
      }
    }
    if (!matched) themes[themes.length - 1].items.push(c);
  });

  // Render theme grid
  const themeGrid = document.getElementById('theme-grid');
  themeGrid.innerHTML = themes.filter(t => t.items.length > 0).sort((a,b) => b.items.length - a.items.length).map(t => `
    <div class="theme">
      <div class="theme-header">
        <div class="theme-name">${t.name}</div>
        <div class="theme-count">${t.items.length}</div>
      </div>
      <div class="theme-quotes">
        ${t.items.slice(0, 2).map(q => `<blockquote>${escapeHtml(q.text.slice(0, 140))}${q.text.length > 140 ? '…' : ''}</blockquote>`).join('')}
      </div>
    </div>
  `).join('');

  // List all comments
  function renderList(filter = '') {
    const container = document.getElementById('comments-list');
    const f = filter.toLowerCase();
    const filtered = f ? allComments.filter(c => c.text.toLowerCase().includes(f) || (c.teacher && c.teacher.toLowerCase().includes(f))) : allComments;
    container.innerHTML = filtered.map(c => `
      <div style="padding: 12px 14px; margin-bottom: 8px; background: var(--bg); border-radius: 8px; border-right: 3px solid var(--accent);">
        <div style="font-size: 13.5px; color: var(--ink); line-height: 1.55; margin-bottom: 6px;">${escapeHtml(c.text)}</div>
        <div style="font-family: var(--mono); font-size: 10px; color: var(--ink-mute); direction: ltr; text-align: right; letter-spacing: 0.05em;">
          ${c.teacher ? escapeHtml(c.teacher) + ' · ' : ''}${c.level || ''}${c.branch ? ' · ' + c.branch : ''}
        </div>
      </div>
    `).join('') || '<p style="color:var(--ink-mute);text-align:center;padding:30px">No comments match.</p>';
  }
  renderList();
  document.getElementById('comment-search').addEventListener('input', e => renderList(e.target.value));
}

// ============ RAW RESPONSES ============
function buildResponses() {
  const responses = SURVEY_DATA.responses;
  const teachers = [...new Set(responses.map(r => r.teacher).filter(Boolean))].sort();
  const branches = [...new Set(responses.map(r => r.branch).filter(Boolean))];
  const levels = [...new Set(responses.map(r => r.level).filter(Boolean))].sort();

  const tSel = document.getElementById('r-teacher');
  teachers.forEach(t => {
    const o = document.createElement('option'); o.value = t; o.textContent = t; tSel.appendChild(o);
  });
  const bSel = document.getElementById('r-branch');
  branches.forEach(b => {
    const o = document.createElement('option'); o.value = b; o.textContent = b; bSel.appendChild(o);
  });
  const lSel = document.getElementById('r-level');
  levels.forEach(l => {
    const o = document.createElement('option'); o.value = l; o.textContent = l; lSel.appendChild(o);
  });

  function render() {
    const tF = tSel.value, bF = bSel.value, lF = lSel.value;
    const search = document.getElementById('r-search').value.toLowerCase();
    let filtered = responses.map((r, i) => ({ ...r, _idx: i + 1 }));
    if (tF !== 'all') filtered = filtered.filter(r => r.teacher === tF);
    if (bF !== 'all') filtered = filtered.filter(r => r.branch === bF);
    if (lF !== 'all') filtered = filtered.filter(r => r.level === lF);
    if (search) {
      filtered = filtered.filter(r =>
        (r.teacher && r.teacher.toLowerCase().includes(search)) ||
        (r.comment && r.comment.toLowerCase().includes(search)) ||
        (r.termId && r.termId.toLowerCase().includes(search))
      );
    }

    document.getElementById('r-count').textContent = `${filtered.length} of ${responses.length}`;
    const tbody = document.querySelector('#responses-table tbody');
    const top = filtered.slice(0, 200);
    tbody.innerHTML = top.map(r => {
      const score = getOverallScore([r]);
      const cls = score >= 80 ? '' : score >= 60 ? 'warn' : 'bad';
      const date = r.timestamp ? r.timestamp.split(' ')[0] : '—';
      return `
        <tr>
          <td>${r._idx}</td>
          <td><div class="cell-name">${escapeHtml(r.teacher || '—')}</div></td>
          <td>${r.level || '—'}</td>
          <td>${r.branch || '—'}</td>
          <td style="font-family:var(--mono)">${escapeHtml(r.termId || '—')}${r.termRaw && r.termRaw !== r.termId ? `<span style="color:var(--ink-mute);font-size:10px" title="what the student typed"> (typed: ${escapeHtml(String(r.termRaw).slice(0,14))})</span>` : ''}</td>
          <td>
            <div class="score-bar">
              <span class="score-bar-num">${score.toFixed(0)}%</span>
              <div class="score-bar-track"><div class="score-bar-fill ${cls}" style="width:${score}%"></div></div>
            </div>
          </td>
          <td style="font-size:12px;max-width:280px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="${escapeHtml(r.comment || '')}">${escapeHtml((r.comment || '').slice(0, 60))}${(r.comment || '').length > 60 ? '…' : ''}</td>
          <td>${date}</td>
        </tr>`;
    }).join('') + (filtered.length > 200 ? `<tr><td colspan="8" style="text-align:center;padding:18px;color:var(--ink-mute);font-family:var(--mono);font-size:11px">Showing top 200 of ${filtered.length} — refine filters for more</td></tr>` : '');
  }

  [tSel, bSel, lSel].forEach(s => s.addEventListener('change', render));
  document.getElementById('r-search').addEventListener('input', render);
  render();
}

// ============ INSIGHTS ============
function buildInsights() {
  const responses = SURVEY_DATA.responses;
  const prev = SURVEY_DATA.prevResponses || [];
  const T = SURVEY_DATA.trend || [];
  const insights = [];
  const recommendations = [];

  const sgn = v => (v > 0 ? '+' : '') + v.toFixed(1);
  const first = T[0], mid = T[1], last = T[T.length - 1];
  const has3 = T.length >= 3;

  const overall = getOverallScore(responses);
  const overallPrev = prev.length ? getOverallScore(prev) : null;
  const promNow = getCategoryScore(responses, 'promotion');
  const discNow = getCategoryScore(responses, 'discipline');
  const engNow = getCategoryScore(responses, 'engagement');

  const punctual = getQuestionScore(responses, 'punctual');
  const respect = getQuestionScore(responses, 'respectsAll');
  const teachAgain = getQuestionScore(responses, 'teachAgain');
  const popQuiz = getQuestionScore(responses, 'popQuiz');
  const popQuizPrev = prev.length ? getQuestionScore(prev, 'popQuiz') : null;
  const arabic = getQuestionScore(responses, 'usesArabic', true);
  const arabicPrev = prev.length ? getQuestionScore(prev, 'usesArabic', true) : null;
  const showsExams = getQuestionScore(responses, 'showsExams');
  const groupWork = getQuestionScore(responses, 'groupWork');
  const speakingTime = getQuestionScore(responses, 'speakingTime');

  const teacherNames = new Set(responses.map(r => r.teacher).filter(Boolean)).size;
  const termMatch = SURVEY_DATA.termMatchCount || 0;
  const termPct = (termMatch / responses.length) * 100;

  const timeSlots = {};
  responses.forEach(r => { if (r.studyTime) timeSlots[r.studyTime] = (timeSlots[r.studyTime] || 0) + 1; });
  const otherTime = timeSlots['غير ذلك'] || 0;

  // sustained decliners across all periods
  let fallers = [];
  if (has3) {
    fallers = SURVEY_DATA.questions.map(q => {
      const v = T.map(p => p.questions[q.key]);
      let down = true;
      for (let i = 1; i < v.length; i++) if (!(v[i] < v[i - 1])) down = false;
      return down ? { q, net: v[v.length - 1] - v[0] } : null;
    }).filter(Boolean).sort((a, b) => a.net - b.net);
  }

  const branches = [...new Set(responses.map(r => r.branch).filter(Boolean))];
  const bScores = branches.map(b => ({
    b, n: responses.filter(r => r.branch === b).length,
    s: getOverallScore(responses.filter(r => r.branch === b))
  })).sort((x, y) => y.s - x.s);

  // ---------------- INSIGHTS ----------------
  if (has3) {
    insights.push({
      cls: 'bad', icon: '▼', h: `August is down — and it is the second signal, not the first.`,
      body: `Overall went ${first.overall.toFixed(1)}% → ${mid.overall.toFixed(1)}% → <span class="stat">${last.overall.toFixed(1)}%</span>. On its own a ${sgn(overall - overallPrev)}pp month could be noise. But <span class="stat">${fallers.length}</span> of ${SURVEY_DATA.questions.length} questions have now declined in <em>every</em> period since April. That consistency is what makes this worth acting on.`
    });
  }

  if (fallers.length) {
    insights.push({
      cls: 'bad', icon: '!', h: 'The decline is concentrated in the human, attention-based items.',
      body: `The steepest sustained falls are ${fallers.slice(0, 5).map(f => `${f.q.en_short} (<span class="stat">${sgn(f.net)}pp</span>)`).join(', ')}. Listening, patience, correcting mistakes, encouraging questions — these are the things that suffer first when staff are stretched thin, and they are falling together rather than separately.`
    });
  }

  insights.push({
    cls: 'warn', icon: '◆', h: `Volume grew ${(((responses.length / (prev.length || 1)) - 1) * 100).toFixed(0)}% while scores fell.`,
    body: `August collected <span class="stat">${responses.length}</span> responses against July's ${prev.length}${has3 ? ` and April–May's ${first.n}` : ''}. Growth is good news commercially, but a broad simultaneous dip in attention-related items is exactly what over-full classes look like. One student put it plainly: "ان لا يزيد عدد الطلاب عن 15". Check average class size and teacher load before drawing conclusions about individuals.`
  });

  insights.push({
    cls: 'bad', icon: '⚠', h: 'Discipline has gone from your best category to your fastest-falling one.',
    body: has3
      ? `It moved ${T.map(p => `${p.categories.discipline.toFixed(1)}%`).join(' → ')}. Punctuality specifically fell from ${first.questions.punctual.toFixed(1)}% to <span class="stat">${last.questions.punctual.toFixed(1)}%</span> — a ${sgn(last.questions.punctual - first.questions.punctual)}pp slide from what was once a 97% strength.`
      : `Now at <span class="stat">${discNow.toFixed(1)}%</span>, with punctuality at ${punctual.score.toFixed(1)}%.`
  });

  if (arabicPrev !== null) {
    insights.push({
      cls: 'bad', icon: '✕', h: 'Arabic in the classroom is now the worst-scoring item you have.',
      body: `On the inverted scale it sits at <span class="stat">${arabic.score.toFixed(1)}%</span>${has3 ? `, having fallen ${first.questions.usesArabic.toFixed(1)}% → ${mid.questions.usesArabic.toFixed(1)}% → ${last.questions.usesArabic.toFixed(1)}% — a net ${sgn(last.questions.usesArabic - first.questions.usesArabic)}pp` : ''}. Teachers are speaking substantially more Arabic each period. For an English institute this is the clearest erosion of the core product, and it has now been flagged two periods running without being addressed.`
    });
  }

  insights.push({
    cls: 'good', icon: '✓', h: 'The promotion win held — proof you can move a metric on purpose.',
    body: has3
      ? `Course promotion went ${T.map(p => `${p.categories.promotion.toFixed(1)}%`).join(' → ')}. It jumped in July when it became a named priority and, crucially, <em>did not snap back</em> in August while everything around it fell. That is the single most encouraging fact in this dataset.`
      : `Holding at <span class="stat">${promNow.toFixed(1)}%</span>.`
  });

  if (popQuizPrev !== null) {
    insights.push({
      cls: 'good', icon: '↑', h: 'Surprise tests improved again — the other deliberate fix that worked.',
      body: `Up <span class="stat">${sgn(popQuiz.score - popQuizPrev.score)}pp</span> this period to ${popQuiz.score.toFixed(1)}%${has3 ? `, from ${first.questions.popQuiz.toFixed(1)}% in April — a net ${sgn(last.questions.popQuiz - first.questions.popQuiz)}pp` : ''}. Like promotion, this moved because it was named and owned. It is no longer your worst item.`
    });
  }

  insights.push({
    cls: '', icon: '◯', h: 'All three branches fell, and the ranking reshuffled.',
    body: `${bScores.map(x => `${x.b} <span class="stat">${x.s.toFixed(1)}%</span> (n=${x.n})`).join(' · ')}. ${has3 ? 'Khormaksar led in July and has since dropped hardest; Taiz is now top. ' : ''}Because every branch moved the same direction, the cause is more likely institute-wide than local.`
  });

  insights.push({
    cls: 'bad', icon: '✕', h: 'The data-quality problems are getting worse, not better.',
    body: `<span class="stat">${teacherNames}</span> distinct teacher-name spellings this period (up from previous months), and only <span class="stat">${termPct.toFixed(0)}%</span> of students entered their branch's real term number. This dashboard uses your authoritative terms rather than the field. Until both become dropdowns, you cannot identify <em>which</em> teachers are driving the decline — which is precisely what you now need.`
  });

  insights.push({
    cls: '', icon: '◯', h: 'Students are rating lower without complaining more.',
    body: `Of ${responses.length} responses, most comments remain positive or neutral, with praise still the largest theme. Explicit complaints about crowding, facilities and fees are present but few. The scores moved well before the comments did, which is typical of gradual drift rather than a single incident — and it means the survey is catching this earlier than word-of-mouth would.`
  });

  insights.push({
    cls: '', icon: '◯', h: 'What is still holding up.',
    body: `Respect for students (<span class="stat">${respect.positive.toFixed(0)}%</span> positive), group and pair work (<span class="stat">${groupWork.positive.toFixed(0)}%</span>), and willingness to take the same teacher again (<span class="stat">${teachAgain.positive.toFixed(0)}%</span>) remain solid in absolute terms. The institute is not in trouble — it is trending the wrong way from a good position, which is the cheapest possible moment to intervene.`
  });

  // ---------------- RECOMMENDATIONS ----------------
  recommendations.push({
    priority: 'high', n: 1, h: 'Audit class sizes and teacher load for August before anything else.',
    body: `<p>Volume rose sharply while the attention-based items fell together. That correlation should be tested first, because if it is the cause, no amount of teacher coaching will fix it.</p>
    <ul>
      <li>Pull actual enrolment per class and per teacher for August and compare against July.</li>
      <li>Identify classes above a sensible cap (a student explicitly suggested 15).</li>
      <li>Check how many teachers took on extra sections, and whether the worst-scoring classes are the largest ones.</li>
      <li>If load is the driver, the fix is hiring or splitting sections — not performance management.</li>
    </ul>`
  });

  recommendations.push({
    priority: 'high', n: 2, h: 'Make teacher name and term dropdowns — this is now blocking.',
    body: `<p>Third period running with this recommendation, and it has become the bottleneck rather than a nice-to-have: <span class="stat">${teacherNames}</span> name variants and <span class="stat">${termPct.toFixed(0)}%</span> correct terms.</p>
    <ul>
      <li>Add a <code>teachers</code> table (teacher_id, name, branch_id, active) and bind the form to it.</li>
      <li>Auto-fill the term per branch — the institute already knows it.</li>
      <li>Without this you can see that quality is falling but not <em>where</em>, which makes every other action a guess.</li>
    </ul>`
  });

  recommendations.push({
    priority: 'high', n: 3, h: 'Set and enforce an English-in-class norm.',
    body: `<p>Now your lowest-scoring item at <span class="stat">${arabic.score.toFixed(1)}%</span> and falling every period. This has been flagged twice without action.</p>
    <ul>
      <li>Define the norm per level — lower levels legitimately need more Arabic, advanced levels should be near-zero.</li>
      <li>Put it on the classroom observation checklist with a concrete threshold.</li>
      <li>Give teachers the practical alternatives (gesture, visuals, graded language) rather than only the rule.</li>
    </ul>`
  });

  recommendations.push({
    priority: 'high', n: 4, h: 'Run a "what changed in August" session with staff.',
    body: `<p>${fallers.length ? `<span class="stat">${fallers.length}</span> questions falling every period` : 'A broad decline'} across all three branches points to something structural. Your teachers already know what it is.</p>
    <ul>
      <li>Ask directly: what is harder now than in April? Class size, hours, admin load, breaks, room conditions?</li>
      <li>Run it as a listening session, not a performance review — the scores are down institute-wide, not for a few individuals.</li>
      <li>Bring the trend charts to the meeting so the conversation starts from shared facts.</li>
    </ul>`
  });

  recommendations.push({
    priority: 'med', n: 5, h: 'Protect the two things that are working.',
    body: `<p>Course promotion and the surprise-test policy both improved and stuck, while everything around them slid. That is not luck — both had a named owner and an explicit instruction.</p>
    <ul>
      <li>Keep the last-week "what comes next" segment and the announced-tests rule exactly as they are.</li>
      <li>Copy the pattern: for each item you want to fix, assign one owner and one concrete behaviour.</li>
      <li>Start measuring actual re-registration rate, not just whether students were told.</li>
    </ul>`
  });

  recommendations.push({
    priority: 'med', n: 6, h: 'Put punctuality back on the agenda.',
    body: `<p>Down ${has3 ? sgn(last.questions.punctual - first.questions.punctual) : sgn(punctual.score - (prev.length ? getQuestionScore(prev, 'punctual').score : punctual.score))}pp since April, from a 97% starting point.</p>
    <ul>
      <li>Establish whether the slip is class start or return after the break — the question covers both.</li>
      <li>Look for structural causes first: back-to-back rooms, teachers travelling between branches, short breaks.</li>
      <li>A visible, simple standard (class starts on the minute) tends to recover this quickly.</li>
    </ul>`
  });

  recommendations.push({
    priority: 'med', n: 7, h: 'Restart exam review as a timetabled slot.',
    body: `<p>Still weak at <span class="stat">${showsExams.score.toFixed(1)}%</span>, with ${showsExams.negative.toFixed(0)}% saying it rarely or never happens.</p>
    <ul>
      <li>Put the review session in the timetable rather than in guidance — the promotion win shows scheduled things stick.</li>
      <li>Teachers bring the three most common mistakes to walk through.</li>
      <li>Check it on observation visits.</li>
    </ul>`
  });

  recommendations.push({
    priority: 'low', n: 8, h: 'Build the speaking-practice bank.',
    body: `<p>Per-student speaking time sits at <span class="stat">${speakingTime.positive.toFixed(0)}%</span> positive and several comments ask for more conversation practice and interactive activities.</p>
    <ul>
      <li>A one-page bank of 60-second prompts per level that teachers can use with no prep.</li>
      <li>One comment suggested stage work, short speeches and paired dialogue — cheap and popular.</li>
      <li>This is the lowest-cost lever left for the teaching-method score.</li>
    </ul>`
  });

  recommendations.push({
    priority: 'low', n: 9, h: 'Clear the recurring facility complaints.',
    body: `<p>Air conditioning, old classrooms and projector screens come up every single period at low volume — which means they are real and unfixed.</p>
    <ul>
      <li>Walk the rooms at each branch and list what is actually broken.</li>
      <li>Fix the AC issues before the next hot term.</li>
      <li>These are small absolute numbers but they colour the "value for money" comments about fees.</li>
    </ul>`
  });

  recommendations.push({
    priority: 'low', n: 10, h: 'Tidy the form for next period.',
    body: `<p>"غير ذلك" (Other) was still chosen <span class="stat">${otherTime}</span> times across ${Object.keys(timeSlots).length} time slots.</p>
    <ul>
      <li>Make the time options match the real timetable, and split the combined "3-5 / 5-7" bucket.</li>
      <li>Consider adding one open question: "has anything got better or worse since your last course?" — it would have caught this trend in words, not just numbers.</li>
    </ul>`
  });

  document.getElementById('insights-list').innerHTML = insights.map(i => `
    <div class="insight ${i.cls}">
      <div class="insight-icon">${i.icon}</div>
      <div class="insight-body">
        <h4>${i.h}</h4>
        <p>${i.body}</p>
      </div>
    </div>
  `).join('');

  document.getElementById('recommendations-list').innerHTML = recommendations.map(r => `
    <div class="rec">
      <div class="rec-num">${String(r.n).padStart(2, '0')}</div>
      <div class="rec-priority ${r.priority}">${r.priority === 'high' ? 'High Priority' : r.priority === 'med' ? 'Medium Priority' : 'Nice to Have'}</div>
      <h4>${r.h}</h4>
      <div class="rec-body">${r.body}</div>
    </div>
  `).join('');
}

// ============ UTILS ============
function escapeHtml(s) {
  if (!s) return '';
  return String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}

