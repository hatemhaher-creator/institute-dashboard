  }

  function showQDetail(key) {
    const q = SURVEY_DATA.questions.find(x => x.key === key);
    const { counts } = getAnswerCounts(responses, key);
    document.getElementById('q-detail-title').textContent = q.ar;
    document.getElementById('q-detail-cat').textContent = CATEGORY_LABELS[q.category];
    if (qDetailChart) qDetailChart.destroy();
    qDetailChart = new Chart(document.getElementById('chart-q-detail'), {
      type: 'bar',
      data: {
        labels: ANSWERS_EN.map((e, i) => `${e} (${ANSWERS[i]})`),
        datasets: [{
          data: ANSWERS.map(a => counts[a]),
          backgroundColor: [C.always, C.usually, C.sometimes, C.rarely, C.never],
          borderRadius: 6,
        }]
      },
      options: {
        responsive: true, maintainAspectRatio: false,
        plugins: { legend: { display: false } },
        scales: {
          x: { grid: { display: false }, ticks: { color: C.inkSoft, font: { size: 11 } } },
          y: { grid: { color: C.line }, ticks: { color: C.inkSoft } }
        }
      }
    });
  }

  catSelect.addEventListener('change', render);
  document.getElementById('q-sort').addEventListener('change', render);
  render();
}

// ============ TEACHERS PANEL ============
function buildTeachers() {
  const responses = SURVEY_DATA.responses;

  // Build teacher map (by exact name as written)
  const teacherMap = {};
  responses.forEach(r => {
    if (!r.teacher) return;
    const t = r.teacher;
    if (!teacherMap[t]) teacherMap[t] = { name: t, responses: [], branches: {} };
    teacherMap[t].responses.push(r);
    if (r.branch) teacherMap[t].branches[r.branch] = (teacherMap[t].branches[r.branch] || 0) + 1;
  });

  // Populate branch filter
  const branches = [...new Set(responses.map(r => r.branch).filter(Boolean))];
  const tBranch = document.getElementById('t-branch');
  branches.forEach(b => {
    const opt = document.createElement('option');
    opt.value = b; opt.textContent = b;
    tBranch.appendChild(opt);
  });

  function render() {
    const min = parseInt(document.getElementById('t-min').value);
    const branchFilter = tBranch.value;
    const sortBy = document.getElementById('t-sort').value;

    let teachers = Object.values(teacherMap).filter(t => t.responses.length >= min);
    if (branchFilter !== 'all') {
      teachers = teachers.filter(t => Object.keys(t.branches).includes(branchFilter));
    }

    teachers = teachers.map(t => ({
      ...t,
      score: getOverallScore(t.responses),
      mainBranch: Object.entries(t.branches).sort((a,b)=>b[1]-a[1])[0]?.[0] || '—'
    }));

    if (sortBy === 'score-desc') teachers.sort((a,b)=>b.score - a.score);
    else if (sortBy === 'score-asc') teachers.sort((a,b)=>a.score - b.score);
    else teachers.sort((a,b)=>b.responses.length - a.responses.length);

    document.getElementById('t-count').textContent = `${teachers.length} Teachers`;

    // Teacher KPIs
    const kpiEl = document.getElementById('teacher-kpis');
    if (teachers.length > 0) {
      const avg = teachers.reduce((s,t) => s+t.score, 0) / teachers.length;
      const best = teachers.reduce((a,b) => a.score > b.score ? a : b);
      const worst = teachers.reduce((a,b) => a.score < b.score ? a : b);
      const above80 = teachers.filter(t => t.score >= 80).length;
      kpiEl.innerHTML = `
        <div class="kpi"><div class="kpi-label">Average Score</div><div class="kpi-value">${avg.toFixed(1)}<span class="unit">%</span></div><div class="kpi-sub">Across ${teachers.length} qualified teachers</div></div>
        <div class="kpi gold"><div class="kpi-label">Highest Score</div><div class="kpi-value" style="font-size:24px">${best.name.length > 14 ? best.name.slice(0,14)+'…' : best.name}</div><div class="kpi-sub">${best.score.toFixed(1)}% · ${best.responses.length} responses</div></div>
        <div class="kpi bad"><div class="kpi-label">Lowest Score</div><div class="kpi-value" style="font-size:24px">${worst.name.length > 14 ? worst.name.slice(0,14)+'…' : worst.name}</div><div class="kpi-sub">${worst.score.toFixed(1)}% · ${worst.responses.length} responses</div></div>
        <div class="kpi"><div class="kpi-label">Above 80%</div><div class="kpi-value">${above80}<span class="unit">/${teachers.length}</span></div><div class="kpi-sub">${(above80/teachers.length*100).toFixed(0)}% of teachers strong</div></div>
      `;
    } else {
      kpiEl.innerHTML = '';
    }

    const tbody = document.querySelector('#teachers-table tbody');
    tbody.innerHTML = teachers.map((t, i) => {
      const cls = t.score >= 80 ? '' : t.score >= 60 ? 'warn' : 'bad';
      const tag = rateTag(t.score);
      return `
        <tr>
          <td><span class="tag tag-neutral">${i+1}</span></td>
          <td><div class="cell-name">${t.name}</div></td>
          <td>${t.mainBranch}</td>
          <td>${t.responses.length}</td>
          <td>
            <div class="score-bar">
              <span class="score-bar-num">${t.score.toFixed(1)}%</span>
              <div class="score-bar-track"><div class="score-bar-fill ${cls}" style="width:${t.score}%"></div></div>
            </div>
          </td>
          <td><span class="tag ${tag.class}">${tag.label}</span></td>
        </tr>`;
    }).join('');
  }

  document.getElementById('t-min').addEventListener('change', render);
  tBranch.addEventListener('change', render);
  document.getElementById('t-sort').addEventListener('change', render);
  render();
}

