<script>



// ============ DECODE COMPACT ANSWERS ============
// Answers are stored as index strings ("11020...") to keep the file small.
// Expand them back into { key: "دائمًا", ... } objects before anything reads them.
(function decodeAnswers() {
  // NOTE: top-level `const` does not attach to `window`, so probe the binding itself.
  if (typeof SURVEY_DATA === 'undefined' || !SURVEY_DATA) return;
  const scale = SURVEY_DATA.answerScale;
  const keys = SURVEY_DATA.qKeys;
  if (!scale || !keys) return;
  const expand = list => (list || []).forEach(r => {
    if (r.answers || typeof r.a !== 'string') return;
    const out = {};
    for (let i = 0; i < keys.length; i++) {
      const ch = r.a[i];
      out[keys[i]] = ch === '-' ? null : scale[+ch];
    }
    r.answers = out;
  });
  expand(SURVEY_DATA.responses);
  expand(SURVEY_DATA.prevResponses);
})();

// ============ DASHBOARD LOGIC ============
const ANSWERS = ['دائمًا', 'عادة', 'أحيانًا', 'نادرًا', 'أبدًا'];
const ANSWERS_EN = ['Always', 'Usually', 'Sometimes', 'Rarely', 'Never'];
const ANSWER_WEIGHTS = { 'دائمًا': 1.0, 'عادة': 0.75, 'أحيانًا': 0.5, 'نادرًا': 0.25, 'أبدًا': 0.0 };

// Color palette — editorial warm
const C = {
  ink: '#1a1814',
  inkSoft: '#4a463f',
  accent: '#1f6f5c',
  accentDeep: '#134235',
  warn: '#c8612c',
  bad: '#b53b3b',
  good: '#2f8c6e',
  gold: '#b08a3e',
  line: '#e8e1d4',
  bgSoft: '#f3ede4',
  // 5-step palette for answers (positive → negative)
  always: '#1f6f5c',
  usually: '#5fa68f',
  sometimes: '#d4b86a',
  rarely: '#d68a55',
  never: '#b53b3b',
};

const CATEGORY_LABELS = {
  engagement: 'Engagement',
  method: 'Teaching Method',
  environment: 'Classroom Environment',
  outcome: 'Learning Outcomes',
  discipline: 'Discipline & Punctuality',
  satisfaction: 'Overall Satisfaction',
  promotion: 'Course Promotion',
};

// ============ ANALYSIS FUNCTIONS ============
function getAnswerCounts(responses, qKey) {
  const counts = { 'دائمًا': 0, 'عادة': 0, 'أحيانًا': 0, 'نادرًا': 0, 'أبدًا': 0 };
  let total = 0;
  responses.forEach(r => {
    const a = r.answers[qKey];
    if (a && counts.hasOwnProperty(a)) {
      counts[a]++;
      total++;
    }
  });
  return { counts, total };
}

function getQuestionScore(responses, qKey, inverted = false) {
  const { counts, total } = getAnswerCounts(responses, qKey);
  if (total === 0) return { score: 0, positive: 0, negative: 0, total: 0 };
  let weighted = 0;
  Object.entries(counts).forEach(([ans, n]) => {
    weighted += ANSWER_WEIGHTS[ans] * n;
  });
  let score = (weighted / total) * 100;
  const positive = ((counts['دائمًا'] + counts['عادة']) / total) * 100;
  const negative = ((counts['نادرًا'] + counts['أبدًا']) / total) * 100;
  if (inverted) {
    // For inverted questions like "uses Arabic in class" — high frequency is bad in an English institute
    score = 100 - score;
  }
  return { score, positive, negative, total, counts };
}

function getOverallScore(responses) {
  let totalScore = 0;
  let count = 0;
  SURVEY_DATA.questions.forEach(q => {
    if (q.category === 'promotion') return; // exclude promotion from overall teaching score
    const { score, total } = getQuestionScore(responses, q.key, q.inverted);
    if (total > 0) {
      totalScore += score;
      count++;
    }
  });
  return count > 0 ? totalScore / count : 0;
}

function getCategoryScore(responses, category) {
  const qs = SURVEY_DATA.questions.filter(q => q.category === category);
  let totalScore = 0;
  let count = 0;
  qs.forEach(q => {
    const { score, total } = getQuestionScore(responses, q.key, q.inverted);
    if (total > 0) {
      totalScore += score;
      count++;
    }
  });
  return count > 0 ? totalScore / count : 0;
}

function rateColor(score) {
  if (score >= 85) return 'good';
  if (score >= 70) return 'neutral';
  if (score >= 55) return 'warn';
  return 'bad';
}

function rateTag(score) {
  if (score >= 85) return { class: 'tag-good', label: 'Excellent' };
  if (score >= 75) return { class: 'tag-good', label: 'Strong' };
  if (score >= 65) return { class: 'tag-neutral', label: 'OK' };
  if (score >= 50) return { class: 'tag-warn', label: 'Weak' };
  return { class: 'tag-bad', label: 'Poor' };
}

// ============ HEADER FILL ============
function fillHeader() {
  const responses = SURVEY_DATA.responses;
  document.getElementById('hd-total').textContent = responses.length;
  const teachers = new Set(responses.map(r => r.teacher).filter(Boolean));
  document.getElementById('hd-teachers').textContent = teachers.size;
  const branches = new Set(responses.map(r => r.branch).filter(Boolean));
  document.getElementById('hd-branches').textContent = branches.size;
  const levels = new Set(responses.map(r => r.level).filter(Boolean));
  document.getElementById('hd-levels').textContent = levels.size;
  const pd = SURVEY_DATA.period;
  const el = document.getElementById('hd-period');
  if (el && pd) el.textContent = pd.range;
}

