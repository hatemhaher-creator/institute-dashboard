<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Institute Survey Dashboard — لوحة تحليل الاستبيان</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<style>
:root {
  --bg: #faf7f2;
  --bg-card: #ffffff;
  --bg-soft: #f3ede4;
  --ink: #1a1814;
  --ink-soft: #4a463f;
  --ink-mute: #8a847a;
  --line: #e8e1d4;
  --line-soft: #f0eadf;
  --accent: #1f6f5c;
  --accent-soft: #e6f0ec;
  --accent-deep: #134235;
  --warn: #c8612c;
  --warn-soft: #faeadd;
  --bad: #b53b3b;
  --bad-soft: #f7e0e0;
  --good: #2f8c6e;
  --gold: #b08a3e;
  --serif: 'Fraunces', 'IBM Plex Sans Arabic', Georgia, serif;
  --sans: 'Inter', 'IBM Plex Sans Arabic', system-ui, sans-serif;
  --arabic: 'IBM Plex Sans Arabic', 'Inter', system-ui, sans-serif;
  --mono: 'JetBrains Mono', monospace;
}

* { box-sizing: border-box; margin: 0; padding: 0; }

html, body {
  background: var(--bg);
  color: var(--ink);
  font-family: var(--arabic);
  font-size: 15px;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

body::before {
  content: "";
  position: fixed;
  inset: 0;
  background-image:
    radial-gradient(circle at 20% 10%, rgba(31,111,92,0.04), transparent 40%),
    radial-gradient(circle at 80% 80%, rgba(176,138,62,0.04), transparent 40%);
  pointer-events: none;
  z-index: 0;
}

.app {
  position: relative;
  z-index: 1;
  max-width: 1440px;
  margin: 0 auto;
  padding: 32px 40px 80px;
}

/* ============ HEADER ============ */
.masthead {
  border-bottom: 1px solid var(--line);
  padding-bottom: 28px;
  margin-bottom: 32px;
  display: grid;
  grid-template-columns: 1fr auto;
  align-items: end;
  gap: 24px;
}

.brand-mark {
  display: flex;
  align-items: center;
  gap: 14px;
  margin-bottom: 14px;
}

.brand-dot {
  width: 38px;
  height: 38px;
  border-radius: 50%;
  background: radial-gradient(circle at 30% 30%, var(--accent) 0%, var(--accent-deep) 70%);
  position: relative;
  box-shadow: 0 4px 14px rgba(31,111,92,0.25);
}
.brand-dot::after {
  content: "";
  position: absolute;
  top: 8px; left: 8px;
  width: 10px; height: 10px;
  border-radius: 50%;
  background: rgba(255,255,255,0.5);
  filter: blur(2px);
}

.brand-text {
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--ink-mute);
}

.masthead h1 {
  font-family: var(--serif);
  font-weight: 500;
  font-size: clamp(34px, 4vw, 52px);
  line-height: 1.05;
  letter-spacing: -0.02em;
  color: var(--ink);
}
.masthead h1 em {
  font-style: italic;
  font-weight: 400;
  color: var(--accent);
}

.masthead-meta {
  text-align: left;
  direction: ltr;
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: 0.1em;
  color: var(--ink-mute);
  text-transform: uppercase;
  line-height: 1.8;
}
.masthead-meta strong {
  font-family: var(--serif);
  font-size: 28px;
  color: var(--ink);
  font-weight: 500;
  letter-spacing: -0.01em;
  text-transform: none;
  display: block;
}

/* ============ TABS ============ */
.tabs {
  display: flex;
  gap: 4px;
  border-bottom: 1px solid var(--line);
  margin-bottom: 32px;
  overflow-x: auto;
  scrollbar-width: none;
}
.tabs::-webkit-scrollbar { display: none; }

.tab {
  background: none;
  border: none;
  padding: 14px 20px;
  font-family: var(--sans);
  font-size: 13px;
  font-weight: 500;
  letter-spacing: 0.02em;
  color: var(--ink-mute);
  cursor: pointer;
  position: relative;
  white-space: nowrap;
  transition: color 0.2s;
  border-bottom: 2px solid transparent;
  margin-bottom: -1px;
}
.tab:hover { color: var(--ink); }
.tab.active {
  color: var(--ink);
  border-bottom-color: var(--accent);
  font-weight: 600;
}
.tab .tab-num {
  font-family: var(--mono);
  font-size: 10px;
  color: var(--ink-mute);
  margin-left: 6px;
  margin-right: 6px;
}
.tab.active .tab-num { color: var(--accent); }

/* ============ PANELS ============ */
.panel { display: none; animation: fadeIn 0.4s ease; }
.panel.active { display: block; }

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(8px); }
  to { opacity: 1; transform: translateY(0); }
}

/* ============ SECTION HEADERS ============ */
.section-eyebrow {
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--accent);
  margin-bottom: 8px;
  direction: ltr;
  text-align: left;
}
.section-title {
  font-family: var(--serif);
  font-weight: 500;
  font-size: 28px;
  line-height: 1.15;
  letter-spacing: -0.015em;
  color: var(--ink);
  margin-bottom: 8px;
}
.section-desc {
  color: var(--ink-soft);
  font-size: 14px;
  max-width: 720px;
  margin-bottom: 28px;
}

/* ============ KPI GRID ============ */
.kpi-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 16px;
  margin-bottom: 32px;
}

.kpi {
  background: var(--bg-card);
  border: 1px solid var(--line);
  border-radius: 14px;
  padding: 20px 22px;
  position: relative;
  overflow: hidden;
  transition: transform 0.2s, box-shadow 0.2s;
}
.kpi:hover {
  transform: translateY(-2px);
  box-shadow: 0 10px 30px -12px rgba(26,24,20,0.12);
}
.kpi::before {
  content: "";
  position: absolute;
  top: 0; right: 0;
  width: 3px; height: 100%;
  background: var(--accent);
  opacity: 0.5;
}
.kpi.warn::before { background: var(--warn); }
.kpi.bad::before { background: var(--bad); }
.kpi.gold::before { background: var(--gold); }

.kpi-label {
  font-family: var(--mono);
  font-size: 10px;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--ink-mute);
  direction: ltr;
  text-align: left;
  margin-bottom: 8px;
}
.kpi-value {
  font-family: var(--serif);
  font-size: 38px;
  font-weight: 500;
  line-height: 1;
  letter-spacing: -0.02em;
  color: var(--ink);
  direction: ltr;
  text-align: left;
}
.kpi-value .unit {
  font-size: 18px;
  color: var(--ink-mute);
  margin-left: 4px;
}
.kpi-sub {
  margin-top: 8px;
  font-size: 12px;
  color: var(--ink-soft);
  direction: ltr;
  text-align: left;
}

/* ============ CARDS ============ */
.card {
  background: var(--bg-card);
  border: 1px solid var(--line);
  border-radius: 14px;
  padding: 24px 26px;
  margin-bottom: 20px;
}
.card-header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 18px;
  padding-bottom: 14px;
  border-bottom: 1px solid var(--line-soft);
  gap: 16px;
}
.card-title {
  font-family: var(--serif);
  font-weight: 500;
  font-size: 19px;
  letter-spacing: -0.01em;
  color: var(--ink);
}
.card-meta {
  font-family: var(--mono);
  font-size: 10px;
  letter-spacing: 0.15em;
  color: var(--ink-mute);
  text-transform: uppercase;
  direction: ltr;
}

.row-2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
}
.row-3 {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
}
@media (max-width: 980px) {
  .row-2, .row-3 { grid-template-columns: 1fr; }
}

/* ============ CHART CONTAINERS ============ */
.chart-wrap {
  position: relative;
  height: 320px;
}
.chart-wrap.tall { height: 480px; }
.chart-wrap.short { height: 240px; }

/* ============ TABLES ============ */
.table-wrap {
  overflow-x: auto;
  margin-top: 8px;
}

table {
  width: 100%;
  border-collapse: collapse;
  font-size: 13px;
}

thead th {
  text-align: right;
  padding: 12px 14px;
  font-family: var(--mono);
  font-size: 10px;
  font-weight: 500;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--ink-mute);
  border-bottom: 1.5px solid var(--ink);
  background: var(--bg-soft);
  white-space: nowrap;
}
thead th:first-child { border-top-right-radius: 6px; }
thead th:last-child { border-top-left-radius: 6px; text-align: left; direction: ltr; }

tbody td {
  padding: 12px 14px;
  border-bottom: 1px solid var(--line-soft);
  color: var(--ink-soft);
  vertical-align: middle;
}
tbody tr:hover { background: var(--bg-soft); }
tbody td:last-child { text-align: left; direction: ltr; font-family: var(--mono); }

.cell-name {
  font-weight: 600;
  color: var(--ink);
  font-family: var(--arabic);
}

.score-bar {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  direction: ltr;
}
.score-bar-track {
  width: 80px;
  height: 6px;
  background: var(--line);
  border-radius: 3px;
  overflow: hidden;
  position: relative;
}
.score-bar-fill {
  height: 100%;
  border-radius: 3px;
  background: var(--accent);
  transition: width 0.6s ease;
}
.score-bar-fill.warn { background: var(--warn); }
.score-bar-fill.bad { background: var(--bad); }
.score-bar-num {
  font-family: var(--mono);
  font-size: 12px;
  color: var(--ink);
  font-weight: 500;
  min-width: 38px;
}

.tag {
  display: inline-block;
  padding: 3px 8px;
  border-radius: 4px;
  font-family: var(--mono);
  font-size: 10px;
  letter-spacing: 0.05em;
  text-transform: uppercase;
}
.tag-good { background: var(--accent-soft); color: var(--accent-deep); }
.tag-warn { background: var(--warn-soft); color: var(--warn); }
.tag-bad { background: var(--bad-soft); color: var(--bad); }
.tag-neutral { background: var(--bg-soft); color: var(--ink-soft); }

/* ============ FILTERS ============ */
.filters {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-bottom: 20px;
  padding: 14px 18px;
  background: var(--bg-card);
  border: 1px solid var(--line);
  border-radius: 12px;
  align-items: center;
}
.filters label {
  font-family: var(--mono);
  font-size: 10px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--ink-mute);
  margin-right: 4px;
}
.filters select, .filters input {
  font-family: var(--arabic);
  font-size: 13px;
  padding: 8px 12px;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: var(--bg);
  color: var(--ink);
  cursor: pointer;
  transition: border-color 0.2s;
}
.filters select:hover, .filters input:hover { border-color: var(--accent); }
.filters select:focus, .filters input:focus {
  outline: none;
  border-color: var(--accent);
  box-shadow: 0 0 0 3px var(--accent-soft);
}

/* ============ INSIGHTS ============ */
.insight {
  display: grid;
  grid-template-columns: auto 1fr;
  gap: 18px;
  padding: 18px 20px;
  margin-bottom: 14px;
  background: var(--bg-card);
  border: 1px solid var(--line);
  border-radius: 12px;
  border-right: 4px solid var(--accent);
  transition: transform 0.2s, box-shadow 0.2s;
}
.insight:hover {
  transform: translateY(-1px);
  box-shadow: 0 6px 20px -10px rgba(26,24,20,0.1);
}
.insight.warn { border-right-color: var(--warn); }
.insight.bad { border-right-color: var(--bad); }
.insight.good { border-right-color: var(--good); }
.insight.gold { border-right-color: var(--gold); }

.insight-icon {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--accent-soft);
  font-family: var(--serif);
  font-weight: 600;
  font-size: 16px;
  color: var(--accent);
  flex-shrink: 0;
}
.insight.warn .insight-icon { background: var(--warn-soft); color: var(--warn); }
.insight.bad .insight-icon { background: var(--bad-soft); color: var(--bad); }
.insight.gold .insight-icon { background: #f5edd9; color: var(--gold); }

.insight-body h4 {
  font-family: var(--serif);
  font-weight: 600;
  font-size: 16px;
  margin-bottom: 4px;
  color: var(--ink);
}
.insight-body p {
  color: var(--ink-soft);
  font-size: 13.5px;
  line-height: 1.55;
}
.insight-body .stat {
  font-family: var(--mono);
  background: var(--bg-soft);
  padding: 1px 6px;
  border-radius: 4px;
  font-size: 12px;
  color: var(--ink);
}

/* ============ RECOMMENDATIONS ============ */
.rec {
  padding: 22px 24px;
  background: var(--bg-card);
  border: 1px solid var(--line);
  border-radius: 12px;
  margin-bottom: 14px;
  position: relative;
}
.rec-num {
  position: absolute;
  top: 18px;
  left: 22px;
  font-family: var(--serif);
  font-style: italic;
  font-size: 28px;
  color: var(--accent);
  opacity: 0.4;
  font-weight: 500;
}
.rec h4 {
  font-family: var(--serif);
  font-weight: 600;
  font-size: 17px;
  margin-bottom: 10px;
  color: var(--ink);
  padding-left: 50px;
}
.rec-priority {
  display: inline-block;
  font-family: var(--mono);
  font-size: 9px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  padding: 2px 8px;
  border-radius: 4px;
  margin-bottom: 8px;
  margin-left: 50px;
}
.rec-priority.high { background: var(--bad-soft); color: var(--bad); }
.rec-priority.med { background: var(--warn-soft); color: var(--warn); }
.rec-priority.low { background: var(--accent-soft); color: var(--accent-deep); }

.rec-body {
  padding-left: 50px;
  color: var(--ink-soft);
  font-size: 14px;
  line-height: 1.65;
}
.rec-body ul { margin-top: 10px; padding-right: 20px; }
.rec-body li { margin-bottom: 4px; }

/* ============ COMMENT THEMES ============ */
.theme-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 14px;
}
.theme {
  padding: 18px 20px;
  background: var(--bg-card);
  border: 1px solid var(--line);
  border-radius: 12px;
}
.theme-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10px;
  padding-bottom: 10px;
  border-bottom: 1px dashed var(--line);
}
.theme-name {
  font-family: var(--serif);
  font-weight: 600;
  font-size: 15px;
  color: var(--ink);
}
.theme-count {
  font-family: var(--mono);
  font-size: 11px;
  color: var(--ink-mute);
  background: var(--bg-soft);
  padding: 2px 8px;
  border-radius: 4px;
}
.theme-quotes {
  font-size: 13px;
  color: var(--ink-soft);
  line-height: 1.55;
}
.theme-quotes blockquote {
  border-right: 2px solid var(--line);
  padding-right: 10px;
  margin-bottom: 8px;
  font-style: italic;
  font-family: var(--arabic);
}

/* ============ PILL FILTER ============ */
.pill-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 16px;
}
.pill {
  padding: 6px 14px;
  font-family: var(--sans);
  font-size: 12px;
  font-weight: 500;
  border: 1px solid var(--line);
  border-radius: 100px;
  background: var(--bg-card);
  color: var(--ink-soft);
  cursor: pointer;
  transition: all 0.15s;
}
.pill:hover { border-color: var(--accent); color: var(--accent); }
.pill.active {
  background: var(--ink);
  color: var(--bg);
  border-color: var(--ink);
}

/* ============ HEATMAP ============ */
.heatmap {
  display: grid;
  gap: 2px;
  font-size: 11px;
}
.heatmap-row {
  display: grid;
  grid-template-columns: 200px repeat(5, 1fr);
  gap: 2px;
  align-items: center;
}
.heatmap-label {
  padding: 8px 10px;
  font-size: 12px;
  color: var(--ink-soft);
  text-align: right;
}
.heatmap-cell {
  padding: 12px 6px;
  text-align: center;
  font-family: var(--mono);
  font-size: 11px;
  font-weight: 500;
  border-radius: 4px;
  transition: transform 0.15s;
}
.heatmap-cell:hover { transform: scale(1.05); }
.heatmap-header {
  padding: 10px 6px;
  text-align: center;
  font-family: var(--mono);
  font-size: 10px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--ink-mute);
  font-weight: 600;
}

/* ============ FOOTER ============ */
.foot {
  margin-top: 60px;
  padding-top: 24px;
  border-top: 1px solid var(--line);
  font-family: var(--mono);
  font-size: 11px;
  color: var(--ink-mute);
  letter-spacing: 0.1em;
  text-transform: uppercase;
  display: flex;
  justify-content: space-between;
  direction: ltr;
}

@media (max-width: 768px) {
  .app { padding: 20px 16px 60px; }
  .masthead { grid-template-columns: 1fr; }
  .masthead-meta { text-align: right; direction: rtl; }
  .heatmap-row { grid-template-columns: 120px repeat(5, 1fr); }
}


/* ============ COMPARISON ============ */
.delta {
  font-family: var(--mono);
  font-size: 12px;
  font-weight: 500;
  padding: 2px 7px;
  border-radius: 4px;
  direction: ltr;
  display: inline-block;
  white-space: nowrap;
}
.delta.up   { background: var(--accent-soft); color: var(--accent-deep); }
.delta.down { background: var(--bad-soft);    color: var(--bad); }
.delta.flat { background: var(--bg-soft);     color: var(--ink-mute); }

.cmp-kpi {
  background: var(--bg-card);
  border: 1px solid var(--line);
  border-radius: 14px;
  padding: 20px 22px;
  position: relative;
  overflow: hidden;
}
.cmp-kpi::before {
  content: ""; position: absolute; top: 0; right: 0;
  width: 3px; height: 100%; background: var(--ink-mute); opacity: .4;
}
.cmp-kpi.up::before   { background: var(--good); opacity: .8; }
.cmp-kpi.down::before { background: var(--bad);  opacity: .8; }
.cmp-pair {
  display: flex; align-items: baseline; gap: 10px;
  direction: ltr; margin-top: 6px;
}
.cmp-now {
  font-family: var(--serif); font-size: 34px; font-weight: 500;
  line-height: 1; letter-spacing: -.02em; color: var(--ink);
}
.cmp-then {
  font-family: var(--mono); font-size: 12px; color: var(--ink-mute);
}
.cmp-legend {
  display: flex; gap: 18px; flex-wrap: wrap;
  font-family: var(--mono); font-size: 10px; letter-spacing: .12em;
  text-transform: uppercase; color: var(--ink-mute);
  margin-bottom: 16px; direction: ltr;
}
.cmp-legend span { display: flex; align-items: center; gap: 6px; }
.cmp-swatch { width: 12px; height: 12px; border-radius: 3px; display: inline-block; }

.note {
  background: var(--warn-soft);
  border: 1px solid #f0d6c0;
  border-radius: 10px;
  padding: 12px 16px;
  font-size: 13px;
  color: #7a3c14;
  margin-bottom: 18px;
  line-height: 1.55;
}
.note strong { color: #5e2d0e; }

/* scrollbar */
.table-wrap::-webkit-scrollbar { height: 6px; }
.table-wrap::-webkit-scrollbar-track { background: var(--bg-soft); }
.table-wrap::-webkit-scrollbar-thumb { background: var(--line); border-radius: 3px; }
</style>
</head>
<body>
<div class="app">

  <!-- MASTHEAD -->
  <header class="masthead">
    <div>
      <div class="brand-mark">
        <div class="brand-dot"></div>
        <div class="brand-text">Institute Insights · August 2026 · Terms 53 / 261 / 250</div>
      </div>
      <h1>Teacher & Classroom <em>Evaluation</em><br>لوحة تحليل استبيان الطلاب</h1>
    </div>
    <div class="masthead-meta">
