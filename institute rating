      tab.classList.add('active');
      document.getElementById('panel-' + target).classList.add('active');
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  });
}

// ============ OVERVIEW PANEL ============
function buildOverview() {
  const responses = SURVEY_DATA.responses;
  const overall = getOverallScore(responses);
  const teachers = new Set(responses.map(r => r.teacher).filter(Boolean));
  const comments = responses.filter(r => r.comment && r.comment.length > 5 && !['لا','لا ','no','لاشي','لا يوجد','nothing','Thanks','thanks'].includes(r.comment.trim().toLowerCase())).length;

  // teach-again positive %
  const teachAgain = getQuestionScore(responses, 'teachAgain');
  const punctual = getQuestionScore(responses, 'punctual');
  const respect = getQuestionScore(responses, 'respectsAll');

  // weakest topic
  // Include inverted questions too, scored on their adjusted scale, so this
  // agrees with the Insights tab about which item is genuinely weakest.
  const allQs = SURVEY_DATA.questions.map(q => ({
    q, ...getQuestionScore(responses, q.key, q.inverted)
  }));
  allQs.sort((a, b) => a.score - b.score);
  const weakest = allQs[0];

  // promotion gap
  const promScore = getCategoryScore(responses, 'promotion');

  const kpis = [
    { label: 'Overall Score', value: overall.toFixed(1), unit: '%', sub: `Weighted across ${SURVEY_DATA.questions.filter(q => q.category !== 'promotion').length} teaching questions`, cls: rateColor(overall) === 'good' ? '' : rateColor(overall) },
    { label: 'Total Responses', value: responses.length, unit: '', sub: `${teachers.size} unique teacher names`, cls: '' },
    { label: 'Would Take Again', value: teachAgain.positive.toFixed(0), unit: '%', sub: 'Said they want this teacher again', cls: rateColor(teachAgain.positive) === 'good' ? '' : rateColor(teachAgain.positive) },
    { label: 'Punctuality', value: punctual.positive.toFixed(0), unit: '%', sub: 'On time to class and after break', cls: 'gold' },
    { label: 'Respect Score', value: respect.positive.toFixed(0), unit: '%', sub: 'Treated all students with respect', cls: '' },
    { label: 'Course Promotion', value: promScore.toFixed(0), unit: '%', sub: 'Lowest-performing category', cls: rateColor(promScore) === 'good' ? '' : rateColor(promScore) },
    { label: 'Written Comments', value: comments, unit: '', sub: 'Substantive student feedback', cls: '' },
    { label: 'Weakest Question', value: weakest.score.toFixed(0), unit: '%', sub: weakest.q.en_short, cls: 'bad' },
  ];

  const grid = document.getElementById('kpi-grid');
  grid.innerHTML = kpis.map(k => `
    <div class="kpi ${k.cls}">
      <div class="kpi-label">${k.label}</div>
      <div class="kpi-value">${k.value}<span class="unit">${k.unit}</span></div>
      <div class="kpi-sub">${k.sub}</div>
    </div>
  `).join('');

  // Sentiment overall donut
  const sentCounts = { 'دائمًا': 0, 'عادة': 0, 'أحيانًا': 0, 'نادرًا': 0, 'أبدًا': 0 };
  SURVEY_DATA.questions.filter(q => q.category !== 'promotion' && !q.inverted).forEach(q => {
    responses.forEach(r => {
      const a = r.answers[q.key];
      if (a && sentCounts.hasOwnProperty(a)) sentCounts[a]++;
    });
  });
  new Chart(document.getElementById('chart-sentiment-overall'), {
    type: 'doughnut',
    data: {
      labels: ANSWERS_EN,
      datasets: [{
        data: Object.values(sentCounts),
        backgroundColor: [C.always, C.usually, C.sometimes, C.rarely, C.never],
        borderColor: '#fff',
        borderWidth: 2,
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: { position: 'right', labels: { font: { family: 'Inter', size: 12 }, padding: 12, color: C.inkSoft } },
        tooltip: {
          callbacks: {
            label: (ctx) => {
              const total = ctx.dataset.data.reduce((a,b)=>a+b,0);
              const pct = ((ctx.raw / total) * 100).toFixed(1);
              return ` ${ctx.label}: ${ctx.raw.toLocaleString()} (${pct}%)`;
            }
          }
        }
      },
      cutout: '60%',
    }
  });

  // Strengths / weaknesses
  const ranked = SURVEY_DATA.questions.filter(q => !q.inverted).map(q => ({
    label: q.en_short,
    score: getQuestionScore(responses, q.key).positive
  })).sort((a, b) => b.score - a.score);
  const top5 = ranked.slice(0, 5);
  const bottom5 = ranked.slice(-5).reverse();
  const swLabels = [...top5.map(x => x.label), '', ...bottom5.map(x => x.label)];
  const swData = [...top5.map(x => x.score), null, ...bottom5.map(x => x.score)];
  const swColors = [...top5.map(() => C.good), C.line, ...bottom5.map(() => C.bad)];

  new Chart(document.getElementById('chart-strengths-weaknesses'), {
    type: 'bar',
    data: {
      labels: swLabels,
      datasets: [{
        data: swData,
        backgroundColor: swColors,
        borderRadius: 4,
      }]
    },
    options: {
      indexAxis: 'y',
      responsive: true,
      maintainAspectRatio: false,
      plugins: { legend: { display: false }, tooltip: {
        callbacks: { label: (c) => c.raw === null ? '' : ` ${c.raw.toFixed(1)}% positive` }
      } },
      scales: {
        x: { min: 0, max: 100, grid: { color: C.line }, ticks: { color: C.inkSoft, callback: v => v + '%' } },
        y: { grid: { display: false }, ticks: { color: C.inkSoft, font: { size: 11 } } }
      }
    }
  });

  // Branch
  const branchCounts = {};
  responses.forEach(r => {
    if (r.branch) branchCounts[r.branch] = (branchCounts[r.branch] || 0) + 1;
  });
  new Chart(document.getElementById('chart-branches'), {
    type: 'bar',
    data: {
      labels: Object.keys(branchCounts),
      datasets: [{ data: Object.values(branchCounts), backgroundColor: C.accent, borderRadius: 6 }]
    },
    options: {
      responsive: true, maintainAspectRatio: false,
      plugins: { legend: { display: false } },
      scales: { x: { grid: { display: false }, ticks: { color: C.inkSoft, font: { size: 10 } } }, y: { grid: { color: C.line }, ticks: { color: C.inkSoft } } }
    }
  });

  // Levels
  const levelCounts = {};
  responses.forEach(r => {
    if (r.level) levelCounts[r.level] = (levelCounts[r.level] || 0) + 1;
  });
  const levelEntries = Object.entries(levelCounts).sort((a,b) => b[1]-a[1]).slice(0, 12);
  new Chart(document.getElementById('chart-levels'), {
    type: 'bar',
    data: {
      labels: levelEntries.map(e => e[0]),
      datasets: [{ data: levelEntries.map(e => e[1]), backgroundColor: C.gold, borderRadius: 6 }]
    },
    options: {
      responsive: true, maintainAspectRatio: false,
      plugins: { legend: { display: false } },
      scales: { x: { grid: { display: false }, ticks: { color: C.inkSoft, font: { size: 9 }, maxRotation: 45 } }, y: { grid: { color: C.line }, ticks: { color: C.inkSoft } } }
    }
  });

  // Times
  const timeCounts = {};
  responses.forEach(r => {
    if (r.studyTime) timeCounts[r.studyTime] = (timeCounts[r.studyTime] || 0) + 1;
  });
  new Chart(document.getElementById('chart-times'), {
    type: 'bar',
    data: {
      labels: Object.keys(timeCounts),
      datasets: [{ data: Object.values(timeCounts), backgroundColor: C.warn, borderRadius: 6 }]
    },
    options: {
      responsive: true, maintainAspectRatio: false,
      plugins: { legend: { display: false } },
      scales: { x: { grid: { display: false }, ticks: { color: C.inkSoft, font: { size: 9 }, maxRotation: 45 } }, y: { grid: { color: C.line }, ticks: { color: C.inkSoft } } }
    }
  });

  // Categories
  const cats = ['engagement', 'method', 'environment', 'outcome', 'discipline', 'satisfaction', 'promotion'];
  const catScores = cats.map(c => getCategoryScore(responses, c));
  new Chart(document.getElementById('chart-categories'), {
    type: 'bar',
    data: {
      labels: cats.map(c => CATEGORY_LABELS[c]),
      datasets: [{
        data: catScores,
        backgroundColor: catScores.map(s => s >= 80 ? C.good : s >= 65 ? C.gold : s >= 50 ? C.warn : C.bad),
        borderRadius: 6,
      }]
    },
    options: {
      responsive: true, maintainAspectRatio: false,
      plugins: { legend: { display: false }, tooltip: { callbacks: { label: c => ` ${c.raw.toFixed(1)}% positive` } } },
      scales: {
        x: { grid: { display: false }, ticks: { color: C.inkSoft } },
        y: { min: 0, max: 100, grid: { color: C.line }, ticks: { color: C.inkSoft, callback: v => v + '%' } }
      }
    }
  });
}

