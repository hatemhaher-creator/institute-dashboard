// ============ HEATMAP ============
function buildHeatmap() {
  const responses = SURVEY_DATA.responses;
  const wrap = document.getElementById('heatmap');

  // header
  let html = `<div class="heatmap-row" style="margin-bottom:4px">
    <div></div>
    ${ANSWERS_EN.map(a => `<div class="heatmap-header">${a}</div>`).join('')}
  </div>`;

  SURVEY_DATA.questions.forEach(q => {
    const { counts, total } = getAnswerCounts(responses, q.key);
    if (total === 0) return;
    html += `<div class="heatmap-row">`;
    html += `<div class="heatmap-label" title="${q.ar}">${q.en_short}</div>`;
    ANSWERS.forEach((a, i) => {
      const pct = (counts[a] / total) * 100;
      // Build color from intensity, with hue depending on answer position
      const hueColors = [C.always, C.usually, C.sometimes, C.rarely, C.never];
      const baseColor = hueColors[i];
      const opacity = Math.max(0.15, Math.min(1, pct / 60));
      const textColor = opacity > 0.5 ? '#fff' : C.ink;
      html += `<div class="heatmap-cell" style="background: ${baseColor}; opacity: ${opacity + 0.1}; color: ${textColor}" title="${a}: ${counts[a]} (${pct.toFixed(1)}%)">${pct.toFixed(0)}%</div>`;
    });
    html += `</div>`;
  });

  wrap.innerHTML = html;
}

// ============ COMMENTS PANEL ============
function buildComments() {
