let qDetailChart = null;
function buildQuestions() {
  const responses = SURVEY_DATA.responses;
  const catSelect = document.getElementById('q-category');
  const cats = [...new Set(SURVEY_DATA.questions.map(q => q.category))];
  cats.forEach(c => {
    const opt = document.createElement('option');
    opt.value = c; opt.textContent = CATEGORY_LABELS[c] || c;
    catSelect.appendChild(opt);
  });

  function render() {
    const cat = catSelect.value;
    const sortBy = document.getElementById('q-sort').value;
    let qs = SURVEY_DATA.questions.map(q => ({
      q,
      ...getQuestionScore(responses, q.key, q.inverted)
    }));
    if (cat !== 'all') qs = qs.filter(x => x.q.category === cat);
    if (sortBy === 'score-desc') qs.sort((a,b) => b.score - a.score);
    else if (sortBy === 'score-asc') qs.sort((a,b) => a.score - b.score);

    document.getElementById('q-count').textContent = `${qs.length} Questions`;

    const tbody = document.querySelector('#questions-table tbody');
    tbody.innerHTML = qs.map((x, i) => {
      const cls = x.score >= 80 ? '' : x.score >= 60 ? 'warn' : 'bad';
      const tag = rateTag(x.score);
      return `
        <tr data-key="${x.q.key}" style="cursor:pointer">
          <td><span class="tag tag-neutral">${i+1}</span></td>
          <td><div class="cell-name">${x.q.ar}</div>${x.q.inverted ? '<div style="font-size:11px;color:var(--ink-mute);font-family:var(--mono);direction:ltr;text-align:right">⚠ inverted (lower is better)</div>' : ''}</td>
          <td><span class="tag tag-neutral">${CATEGORY_LABELS[x.q.category]}</span></td>
          <td>
            <div class="score-bar">
              <span class="score-bar-num">${x.positive.toFixed(0)}%</span>
              <div class="score-bar-track"><div class="score-bar-fill ${cls}" style="width:${x.positive}%"></div></div>
            </div>
          </td>
          <td><span class="tag ${tag.class}">${tag.label}</span></td>
        </tr>`;
    }).join('');

    tbody.querySelectorAll('tr').forEach(tr => {
      tr.addEventListener('click', () => showQDetail(tr.dataset.key));
    });
