<script>

// ============ COMPARISON: JULY vs APR–MAY ============
const CMP_NOW = '#1f6f5c';
const CMP_THEN = '#c9c0b0';

function fmtDelta(d, digits = 1) {
  const sign = d > 0 ? '+' : '';
  return `${sign}${d.toFixed(digits)}`;
}

function deltaBadge(d, suffix = 'pp') {
  const cls = Math.abs(d) < 0.5 ? 'flat' : (d > 0 ? 'up' : 'down');
  const arrow = Math.abs(d) < 0.5 ? '→' : (d > 0 ? '▲' : '▼');
  return `<span class="delta ${cls}">${arrow} ${fmtDelta(d)}${suffix}</span>`;
}

function buildCompare() {
  const now = SURVEY_DATA.responses;
  const then = SURVEY_DATA.prevResponses || [];
  if (!then.length) {
    document.getElementById('panel-compare').innerHTML =
      '<p style="color:var(--ink-mute);padding:40px;text-align:center">No previous-period data available for comparison.</p>';
    return;
  }

  document.getElementById('cmp-n-now').textContent = now.length;
  document.getElementById('cmp-n-then').textContent = then.length;

  // ---------- KPI cards ----------
  const oNow = getOverallScore(now), oThen = getOverallScore(then);
  const taNow = getQuestionScore(now, 'teachAgain').positive;
  const taThen = getQuestionScore(then, 'teachAgain').positive;
  const prNow = getCategoryScore(now, 'promotion');
  const prThen = getCategoryScore(then, 'promotion');
  const mNow = getCategoryScore(now, 'method');
  const mThen = getCategoryScore(then, 'method');
  const pqNow = getQuestionScore(now, 'popQuiz').positive;
  const pqThen = getQuestionScore(then, 'popQuiz').positive;
  const seNow = getQuestionScore(now, 'showsExams').positive;
  const seThen = getQuestionScore(then, 'showsExams').positive;

  const cmpKpis = [
    { label: 'Overall Score', now: oNow, then: oThen, unit: '%' },
    { label: 'Would Take Again', now: taNow, then: taThen, unit: '%' },
    { label: 'Course Promotion', now: prNow, then: prThen, unit: '%' },
    { label: 'Teaching Method', now: mNow, then: mThen, unit: '%' },
    { label: 'Reviews Exams', now: seNow, then: seThen, unit: '%' },
    { label: 'Surprise Tests', now: pqNow, then: pqThen, unit: '%' },
    { label: 'Responses', now: now.length, then: then.length, unit: '', raw: true },
  ];

  document.getElementById('cmp-kpis').innerHTML = cmpKpis.map(k => {
    const d = k.now - k.then;
    const cls = Math.abs(d) < 0.5 ? '' : (d > 0 ? 'up' : 'down');
    const nowTxt = k.raw ? k.now : k.now.toFixed(1);
    const thenTxt = k.raw ? k.then : k.then.toFixed(1);
    const badge = k.raw
      ? `<span class="delta ${d > 0 ? 'up' : d < 0 ? 'down' : 'flat'}">${d > 0 ? '▲' : d < 0 ? '▼' : '→'} ${d > 0 ? '+' : ''}${d}</span>`
      : deltaBadge(d, 'pp');
    return `
      <div class="cmp-kpi ${cls}">
        <div class="kpi-label">${k.label}</div>
        <div class="cmp-pair">
          <span class="cmp-now">${nowTxt}<span style="font-size:16px;color:var(--ink-mute)">${k.unit}</span></span>
          ${badge}
        </div>
        <div class="kpi-sub">was ${thenTxt}${k.unit} in July</div>
      </div>`;
  }).join('');

  // ---------- Category grouped bars ----------
  const cats = ['engagement', 'method', 'environment', 'outcome', 'discipline', 'satisfaction', 'promotion'];
  new Chart(document.getElementById('chart-cmp-categories'), {
    type: 'bar',
    data: {
      labels: cats.map(c => CATEGORY_LABELS[c]),
      datasets: [
        { label: 'July 2026', data: cats.map(c => getCategoryScore(then, c)), backgroundColor: CMP_THEN, borderRadius: 5 },
        { label: 'August 2026', data: cats.map(c => getCategoryScore(now, c)), backgroundColor: CMP_NOW, borderRadius: 5 },
      ]
    },
    options: {
      responsive: true, maintainAspectRatio: false,
      plugins: {
        legend: { position: 'top', labels: { color: C.inkSoft, font: { family: 'Inter', size: 12 }, padding: 14 } },
        tooltip: { callbacks: { label: c => ` ${c.dataset.label}: ${c.raw.toFixed(1)}%` } }
      },
      scales: {
        x: { grid: { display: false }, ticks: { color: C.inkSoft, font: { size: 11 } } },
        y: { min: 0, max: 100, grid: { color: C.line }, ticks: { color: C.inkSoft, callback: v => v + '%' } }
      }
    }
  });

  // ---------- Per-question deltas ----------
  const qDeltas = SURVEY_DATA.questions.map(q => {
    const inv = q.inverted;
    const a = getQuestionScore(then, q.key, inv);
    const b = getQuestionScore(now, q.key, inv);
    return { q, then: a.score, now: b.score, delta: b.score - a.score };
  });

  const gains = [...qDeltas].sort((a, b) => b.delta - a.delta).slice(0, 8);
  const losses = [...qDeltas].sort((a, b) => a.delta - b.delta).slice(0, 8);

  function deltaChart(canvasId, rows, color) {
    new Chart(document.getElementById(canvasId), {
      type: 'bar',
      data: {
        labels: rows.map(r => r.q.en_short),
        datasets: [{ data: rows.map(r => r.delta), backgroundColor: color, borderRadius: 4 }]
      },
      options: {
        indexAxis: 'y',
        responsive: true, maintainAspectRatio: false,
        plugins: {
          legend: { display: false },
          tooltip: { callbacks: { label: c => ` ${fmtDelta(c.raw)}pp (${rows[c.dataIndex].then.toFixed(1)}% → ${rows[c.dataIndex].now.toFixed(1)}%)` } }
        },
        scales: {
          x: { grid: { color: C.line }, ticks: { color: C.inkSoft, callback: v => fmtDelta(v, 0) + 'pp' } },
          y: { grid: { display: false }, ticks: { color: C.inkSoft, font: { size: 10 } } }
        }
      }
    });
  }
  deltaChart('chart-cmp-gains', gains, C.good);
  deltaChart('chart-cmp-losses', losses, C.bad);

  // ---------- Answer mix shift ----------
  function mix(rs) {
    const c = { 'دائمًا': 0, 'عادة': 0, 'أحيانًا': 0, 'نادرًا': 0, 'أبدًا': 0 };
    let t = 0;
    SURVEY_DATA.questions.filter(q => q.category !== 'promotion' && !q.inverted).forEach(q => {
      rs.forEach(r => {
        const a = r.answers[q.key];
        if (a && c.hasOwnProperty(a)) { c[a]++; t++; }
      });
    });
    return ANSWERS.map(a => t ? (c[a] / t) * 100 : 0);
  }
  const mixThen = mix(then), mixNow = mix(now);
  new Chart(document.getElementById('chart-cmp-mix'), {
    type: 'bar',
    data: {
      labels: ANSWERS_EN.map((e, i) => `${e} (${ANSWERS[i]})`),
      datasets: [
        { label: 'July 2026', data: mixThen, backgroundColor: CMP_THEN, borderRadius: 5 },
        { label: 'August 2026', data: mixNow, backgroundColor: CMP_NOW, borderRadius: 5 },
      ]
    },
    options: {
      responsive: true, maintainAspectRatio: false,
      plugins: {
        legend: { position: 'top', labels: { color: C.inkSoft, font: { family: 'Inter', size: 12 }, padding: 14 } },
        tooltip: { callbacks: { label: c => ` ${c.dataset.label}: ${c.raw.toFixed(1)}% of all answers` } }
      },
      scales: {
        x: { grid: { display: false }, ticks: { color: C.inkSoft, font: { size: 11 } } },
        y: { grid: { color: C.line }, ticks: { color: C.inkSoft, callback: v => v + '%' } }
      }
    }
  });

  // ---------- Full question table ----------
  const cmpSort = document.getElementById('cmp-sort');
  function renderCmpTable() {
    let rows = [...qDeltas];
    const v = cmpSort.value;
    if (v === 'delta-desc') rows.sort((a, b) => b.delta - a.delta);
    else if (v === 'delta-asc') rows.sort((a, b) => a.delta - b.delta);
    else if (v === 'now-desc') rows.sort((a, b) => b.now - a.now);
    else rows.sort((a, b) => a.q.category.localeCompare(b.q.category) || b.now - a.now);

    document.getElementById('cmp-q-count').textContent = `${rows.length} Questions`;
    document.querySelector('#cmp-table tbody').innerHTML = rows.map((r, i) => `
      <tr>
        <td><span class="tag tag-neutral">${i + 1}</span></td>
        <td><div class="cell-name">${r.q.ar}</div>${r.q.inverted ? '<div style="font-size:11px;color:var(--ink-mute);font-family:var(--mono)">⚠ inverted</div>' : ''}</td>
        <td><span class="tag tag-neutral">${CATEGORY_LABELS[r.q.category]}</span></td>
        <td style="font-family:var(--mono);color:var(--ink-mute)">${r.then.toFixed(1)}%</td>
        <td style="font-family:var(--mono);color:var(--ink);font-weight:600">${r.now.toFixed(1)}%</td>
        <td>${deltaBadge(r.delta)}</td>
      </tr>`).join('');
  }
  cmpSort.addEventListener('change', renderCmpTable);
  renderCmpTable();

  // ---------- Branch comparison ----------
  const thenWithBranch = then.filter(r => r.branch);
  const cov = (thenWithBranch.length / then.length) * 100;
  document.getElementById('cmp-branch-note').innerHTML = cov > 99
    ? `<strong>Both periods have full branch coverage</strong> — July <span style="font-family:var(--mono)">${thenWithBranch.length}/${then.length}</span> and August <span style="font-family:var(--mono)">${now.length}/${now.length}</span>. These branch deltas are exact, unlike the Apr–May comparison where the branch field was still optional.`
    : `<strong>Read this table with care.</strong> Only <span style="font-family:var(--mono)">${thenWithBranch.length}/${then.length}</span> (${cov.toFixed(0)}%) of the earlier period recorded a branch, so these deltas are indicative rather than exact.`;

  const branches = [...new Set(now.map(r => r.branch).filter(Boolean))];
  const terms = SURVEY_DATA.canonicalTerms || {};
  document.querySelector('#cmp-branch-table tbody').innerHTML = branches.map(b => {
    const rn = now.filter(r => r.branch === b);
    const rt = thenWithBranch.filter(r => r.branch === b);
    const sn = getOverallScore(rn);
    const st = rt.length ? getOverallScore(rt) : null;
    const d = st === null ? null : sn - st;
    return `
      <tr>
        <td><div class="cell-name">${b}</div><div style="font-size:11px;color:var(--ink-mute)">${(rn[0] && rn[0].branchEn) || ''}</div></td>
        <td style="font-family:var(--mono)">${terms[b] || '—'}</td>
        <td>${rt.length || '—'}</td>
        <td>${rn.length}</td>
        <td style="font-family:var(--mono);color:var(--ink-mute)">${st === null ? '—' : st.toFixed(1) + '%'}</td>
        <td style="font-family:var(--mono);color:var(--ink);font-weight:600">${sn.toFixed(1)}%</td>
        <td>${d === null ? '<span class="delta flat">n/a</span>' : deltaBadge(d)}</td>
      </tr>`;
  }).join('');

  // ---------- Narrative read-out ----------
  const nar = [];
  const dOverall = oNow - oThen;
  nar.push({
    cls: Math.abs(dOverall) < 0.5 ? '' : (dOverall > 0 ? 'good' : 'bad'),
    icon: dOverall > 0 ? '▲' : (dOverall < 0 ? '▼' : '→'),
    h: `Overall score moved ${fmtDelta(dOverall)}pp — from ${oThen.toFixed(1)}% to ${oNow.toFixed(1)}%.`,
    body: Math.abs(dOverall) < 1
      ? `Effectively flat. Teaching quality is holding steady across a completely different cohort of students, which is a good sign of consistency rather than luck.`
      : (dOverall > 0
        ? `A real improvement across the board. The gains are concentrated in ${gains[0].q.en_short.toLowerCase()} and ${gains[1].q.en_short.toLowerCase()}.`
        : `A genuine slip. The decline is driven mostly by ${losses[0].q.en_short.toLowerCase()} and ${losses[1].q.en_short.toLowerCase()}.`)
  });

  nar.push({
    cls: 'good', icon: '↑',
    h: `Biggest gain: ${gains[0].q.en_short} (${fmtDelta(gains[0].delta)}pp).`,
    body: `Moved from <span class="stat">${gains[0].then.toFixed(1)}%</span> to <span class="stat">${gains[0].now.toFixed(1)}%</span>. Also up sharply: ${gains.slice(1, 4).map(g => `${g.q.en_short} (${fmtDelta(g.delta)}pp)`).join(', ')}. Whatever changed here is worth naming explicitly so it doesn't get lost.`
  });

  nar.push({
    cls: 'bad', icon: '↓',
    h: `Biggest drop: ${losses[0].q.en_short} (${fmtDelta(losses[0].delta)}pp).`,
    body: `Fell from <span class="stat">${losses[0].then.toFixed(1)}%</span> to <span class="stat">${losses[0].now.toFixed(1)}%</span>. Also down: ${losses.slice(1, 4).map(l => `${l.q.en_short} (${fmtDelta(l.delta)}pp)`).join(', ')}. These are the items to raise at the next staff meeting.`
  });

  const dProm = prNow - prThen;
  nar.push({
    cls: dProm > 0 ? 'good' : 'warn', icon: '◆',
    h: `Course promotion ${dProm > 0 ? 'improved' : 'slipped'} ${fmtDelta(dProm)}pp.`,
    body: `Still the weakest category at <span class="stat">${prNow.toFixed(1)}%</span> (was ${prThen.toFixed(1)}%). ${dProm > 3 ? 'The push is working — keep going.' : 'Not enough movement. This remains the clearest revenue gap in the whole survey.'}`
  });

  // Cohort composition change
  const lvNow = {}, lvThen = {};
  now.forEach(r => { if (r.level) lvNow[r.level] = (lvNow[r.level] || 0) + 1; });
  then.forEach(r => { if (r.level) lvThen[r.level] = (lvThen[r.level] || 0) + 1; });
  const topNow = Object.entries(lvNow).sort((a, b) => b[1] - a[1])[0];
  const topThen = Object.entries(lvThen).sort((a, b) => b[1] - a[1])[0];
  nar.push({
    cls: '', icon: '◯',
    h: 'The cohort grew sharply, which colours every comparison.',
    body: `August's largest level group is <span class="stat">${topNow[0]}</span> (${topNow[1]} students); in July it was <span class="stat">${topThen[0]}</span> (${topThen[1]}). August also carries <span class="stat">${now.length}</span> responses against July's ${then.length} — a ${(((now.length / then.length) - 1) * 100).toFixed(0)}% jump. A bigger, broader cohort is itself a plausible driver of softer scores, so check class sizes before reading this as a drop in teaching quality.`
  });

  document.getElementById('cmp-narrative').innerHTML = nar.map(i => `
    <div class="insight ${i.cls}">
      <div class="insight-icon">${i.icon}</div>
      <div class="insight-body"><h4>${i.h}</h4><p>${i.body}</p></div>
    </div>`).join('');
}


</script>
<script>
// ============ TREND: THREE PERIODS ============
const TREND_COLORS = ['#c9c0b0', '#b08a3e', '#1f6f5c']; // Apr–May, Jul, Aug

function buildTrend() {
  const T = SURVEY_DATA.trend;
  if (!T || T.length < 2) {
    const p = document.getElementById('panel-trend');
    if (p) p.innerHTML = '<p style="color:var(--ink-mute);padding:40px;text-align:center">Not enough periods for a trend.</p>';
    return;
  }
  const labels = T.map(p => p.short);
  const last = T[T.length - 1], prev = T[T.length - 2], first = T[0];

  // ---------- KPIs ----------
  const netOverall = last.overall - first.overall;
  const stepOverall = last.overall - prev.overall;

  // count sustained decliners / risers across the full series
  let decl = 0, rise = 0;
  SURVEY_DATA.questions.forEach(q => {
    const v = T.map(p => p.questions[q.key]);
    let d = true, r = true;
    for (let i = 1; i < v.length; i++) { if (!(v[i] < v[i - 1])) d = false; if (!(v[i] > v[i - 1])) r = false; }
    if (d) decl++; if (r) rise++;
  });

  const volNet = last.n - first.n;
  const catNet = {};
  Object.keys(last.categories).forEach(c => { catNet[c] = last.categories[c] - first.categories[c]; });
  const worstCat = Object.entries(catNet).sort((a, b) => a[1] - b[1])[0];
  const bestCat = Object.entries(catNet).sort((a, b) => b[1] - a[1])[0];

  const kpis = [
    { label: 'Overall Now', v: last.overall.toFixed(1), u: '%', sub: `${fmtDelta(stepOverall)}pp vs ${prev.short}`, cls: stepOverall >= 0 ? '' : 'bad' },
    { label: 'Net Since Apr–May', v: fmtDelta(netOverall), u: 'pp', sub: `${first.overall.toFixed(1)}% → ${last.overall.toFixed(1)}%`, cls: netOverall >= 0 ? '' : 'bad' },
    { label: 'Falling 2 Periods', v: decl, u: `/${SURVEY_DATA.questions.length}`, sub: 'Questions down every period', cls: decl > 8 ? 'bad' : 'warn' },
    { label: 'Rising 2 Periods', v: rise, u: `/${SURVEY_DATA.questions.length}`, sub: 'Questions up every period', cls: '' },
    { label: 'Best Category Move', v: fmtDelta(bestCat[1]), u: 'pp', sub: CATEGORY_LABELS[bestCat[0]], cls: 'gold' },
    { label: 'Worst Category Move', v: fmtDelta(worstCat[1]), u: 'pp', sub: CATEGORY_LABELS[worstCat[0]], cls: 'bad' },
    { label: 'Response Volume', v: last.n, u: '', sub: `${fmtDelta(volNet, 0)} vs Apr–May`, cls: '' },
  ];
  document.getElementById('trend-kpis').innerHTML = kpis.map(k => `
    <div class="kpi ${k.cls}">
      <div class="kpi-label">${k.label}</div>
      <div class="kpi-value">${k.v}<span class="unit">${k.u}</span></div>
      <div class="kpi-sub">${k.sub}</div>
    </div>`).join('');

  const lineOpts = (min, max) => ({
    responsive: true, maintainAspectRatio: false,
    plugins: {
      legend: { position: 'top', labels: { color: C.inkSoft, font: { family: 'Inter', size: 12 }, padding: 14, usePointStyle: true } },
      tooltip: { callbacks: { label: c => ` ${c.dataset.label}: ${c.raw.toFixed(1)}%` } }
    },
    scales: {
      x: { grid: { display: false }, ticks: { color: C.inkSoft, font: { size: 12 } } },
      y: { min, max, grid: { color: C.line }, ticks: { color: C.inkSoft, callback: v => v + '%' } }
    }
  });

  // ---------- Overall line ----------
  new Chart(document.getElementById('chart-trend-overall'), {
    type: 'line',
    data: {
      labels,
      datasets: [{
        label: 'Overall score',
        data: T.map(p => p.overall),
        borderColor: C.accent, backgroundColor: 'rgba(31,111,92,.10)',
        borderWidth: 3, fill: true, tension: .3,
        pointRadius: 6, pointBackgroundColor: C.accent, pointBorderColor: '#fff', pointBorderWidth: 2,
      }]
    },
    options: lineOpts(75, 90)
  });

  // ---------- All categories ----------
  const cats = ['engagement', 'method', 'environment', 'outcome', 'discipline', 'satisfaction', 'promotion'];
  const catPalette = ['#1f6f5c', '#b08a3e', '#5fa68f', '#c8612c', '#134235', '#8a847a', '#b53b3b'];
  new Chart(document.getElementById('chart-trend-categories'), {
    type: 'line',
    data: {
      labels,
      datasets: cats.map((c, i) => ({
        label: CATEGORY_LABELS[c],
        data: T.map(p => p.categories[c]),
        borderColor: catPalette[i], backgroundColor: catPalette[i],
        borderWidth: 2, fill: false, tension: .3,
        pointRadius: 4, pointBorderColor: '#fff', pointBorderWidth: 1.5,
      }))
    },
    options: lineOpts(55, 100)
  });

  // ---------- Branch trajectories ----------
  const allBranches = [...new Set(T.flatMap(p => Object.keys(p.branches)))];
  new Chart(document.getElementById('chart-trend-branches'), {
    type: 'line',
    data: {
      labels,
      datasets: allBranches.map((b, i) => ({
        label: b,
        data: T.map(p => (p.branches[b] ? p.branches[b].score : null)),
        borderColor: catPalette[i], backgroundColor: catPalette[i],
        borderWidth: 2.5, fill: false, tension: .3, spanGaps: true,
        pointRadius: 5, pointBorderColor: '#fff', pointBorderWidth: 2,
      }))
    },
    options: lineOpts(72, 92)
  });

  // ---------- Single-question tracer ----------
  const sel = document.getElementById('trend-q');
  SURVEY_DATA.questions.forEach(q => {
    const o = document.createElement('option');
    o.value = q.key;
    o.textContent = q.en_short;
    sel.appendChild(o);
  });
  let qChart = null;
  function drawQ(key) {
    const q = SURVEY_DATA.questions.find(x => x.key === key) || SURVEY_DATA.questions[0];
    const vals = T.map(p => p.questions[q.key]);
    if (qChart) qChart.destroy();
    qChart = new Chart(document.getElementById('chart-trend-question'), {
      type: 'line',
      data: {
        labels,
        datasets: [{
          label: q.en_short,
          data: vals,
          borderColor: C.gold, backgroundColor: 'rgba(176,138,62,.12)',
          borderWidth: 3, fill: true, tension: .3,
          pointRadius: 6, pointBackgroundColor: C.gold, pointBorderColor: '#fff', pointBorderWidth: 2,
        }]
      },
      options: lineOpts(Math.max(0, Math.min(...vals) - 12), Math.min(100, Math.max(...vals) + 12))
    });
  }
  sel.addEventListener('change', e => drawQ(e.target.value));
  drawQ(SURVEY_DATA.questions[0].key);

  // ---------- Sustained movers table ----------
  const rows = SURVEY_DATA.questions.map(q => {
    const v = T.map(p => p.questions[q.key]);
    let down = true, up = true;
    for (let i = 1; i < v.length; i++) { if (!(v[i] < v[i - 1])) down = false; if (!(v[i] > v[i - 1])) up = false; }
    return { q, v, net: v[v.length - 1] - v[0], pattern: down ? 'down' : up ? 'up' : 'mixed' };
  }).filter(r => r.pattern !== 'mixed').sort((a, b) => a.net - b.net);

  document.querySelector('#trend-table tbody').innerHTML = rows.map((r, i) => {
    const tag = r.pattern === 'down'
      ? '<span class="tag tag-bad">Falling</span>'
      : '<span class="tag tag-good">Rising</span>';
    return `
      <tr>
        <td><span class="tag tag-neutral">${i + 1}</span></td>
        <td><div class="cell-name">${r.q.ar}</div>${r.q.inverted ? '<div style="font-size:11px;color:var(--ink-mute);font-family:var(--mono)">⚠ inverted</div>' : ''}</td>
        <td><span class="tag tag-neutral">${CATEGORY_LABELS[r.q.category]}</span></td>
        ${r.v.map((x, j) => `<td style="font-family:var(--mono);color:${j === r.v.length - 1 ? 'var(--ink);font-weight:600' : 'var(--ink-mute)'}">${x.toFixed(1)}%</td>`).join('')}
        <td>${deltaBadge(r.net)}</td>
        <td>${tag}</td>
      </tr>`;
  }).join('') || '<tr><td colspan="8" style="text-align:center;padding:24px;color:var(--ink-mute)">No question moved consistently in one direction.</td></tr>';

  // ---------- Narrative ----------
  const fallers = rows.filter(r => r.pattern === 'down');
  const risers = rows.filter(r => r.pattern === 'up');
  const nar = [];

  nar.push({
    cls: stepOverall < 0 ? 'bad' : 'good',
    icon: stepOverall < 0 ? '▼' : '▲',
    h: `Overall went ${first.overall.toFixed(1)}% → ${T[1].overall.toFixed(1)}% → ${last.overall.toFixed(1)}%.`,
    body: `July ticked up, August gave it back and more — a net <span class="stat">${fmtDelta(netOverall)}pp</span> since April. One down month is noise; the shape underneath is what matters, and that is covered below.`
  });

  if (fallers.length) {
    nar.push({
      cls: 'bad', icon: '!',
      h: `${fallers.length} of ${SURVEY_DATA.questions.length} questions have fallen in every single period.`,
      body: `Not a one-month wobble. The steepest are ${fallers.slice(0, 4).map(f => `<strong>${f.q.en_short}</strong> (${fmtDelta(f.net)}pp)`).join(', ')}. When this many items slide together, the cause is usually systemic — staffing, workload or class size — rather than individual teachers.`
    });
  }

  const dPat = last.categories.discipline - first.categories.discipline;
  nar.push({
    cls: 'bad', icon: '◆',
    h: `Discipline has fallen ${fmtDelta(dPat)}pp and is now your fastest-eroding category.`,
    body: `It went ${T.map(p => `${p.categories.discipline.toFixed(1)}%`).join(' → ')}. In April this was your single strongest area. Punctuality alone dropped from ${first.questions.punctual.toFixed(1)}% to <span class="stat">${last.questions.punctual.toFixed(1)}%</span>.`
  });

  const dProm = last.categories.promotion - first.categories.promotion;
  nar.push({
    cls: 'good', icon: '✓',
    h: `Course promotion is the one durable win: ${fmtDelta(dProm)}pp since April.`,
    body: `It went ${T.map(p => `${p.categories.promotion.toFixed(1)}%`).join(' → ')} — jumped in July after it became a priority, and <em>held</em> in August rather than snapping back. That is proof the institute can move a metric deliberately when someone owns it.`
  });

  if (risers.length) {
    nar.push({
      cls: 'good', icon: '↑',
      h: `${risers.length} question${risers.length > 1 ? 's have' : ' has'} improved every period.`,
      body: `${risers.map(r => `<strong>${r.q.en_short}</strong> (${fmtDelta(r.net)}pp)`).join(', ')}. Worth protecting — these are the areas where a deliberate change stuck.`
    });
  }

  nar.push({
    cls: 'warn', icon: '◯',
    h: `Volume grew ${fmtDelta(volNet, 0)} responses while quality fell.`,
    body: `August collected <span class="stat">${last.n}</span> responses versus ${first.n} in April–May. More students per teacher is the most plausible single explanation for a broad, simultaneous decline in the attention-related items — listening, patience, helping, Q&A. Worth checking average class size and teacher load for August before concluding anything about individuals.`
  });

  document.getElementById('trend-narrative').innerHTML = nar.map(i => `
    <div class="insight ${i.cls}">
      <div class="insight-icon">${i.icon}</div>
      <div class="insight-body"><h4>${i.h}</h4><p>${i.body}</p></div>
    </div>`).join('');
}

</script>
</body>
</html>
