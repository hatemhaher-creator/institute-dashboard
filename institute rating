  const trivial = ['لا','لا ','la','no','nothing','none','ﻻ','لاشي','لا شي','لا شيء','لايوجد','لا يوجد','لا يوجد ','thanks','thank','شكرا','شكراً'];
  const allComments = responses
    .map((r, i) => ({ idx: i, text: r.comment, teacher: r.teacher, branch: r.branch, level: r.level }))
    .filter(c => c.text && c.text.trim().length > 5)
